# ==========================================================
# MEDICATION MANAGEMENT SYSTEM — MULTI-AGENT ENVIRONMENT CONFIG
# ==========================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ----------------------------------------------------------
# SUPABASE CONFIGURATION
# ----------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# ----------------------------------------------------------
# MULTI-AGENT AI CONFIGURATION (INDEPENDENT PER AGENT)
# Different agents can use different providers, models & keys!
# Supported Providers: google | openai | anthropic
# ----------------------------------------------------------

# 1. OCR Agent (Prescriptions & Medicine packaging extraction)
OCR_AI_PROVIDER=google
OCR_AI_MODEL=gemini-1.5-flash
OCR_AI_API_KEY=your_ocr_agent_api_key

# 2. Medication Analysis Agent (Food rules, interactions, precautions)
MEDICATION_AI_PROVIDER=google
MEDICATION_AI_MODEL=gemini-1.5-flash
MEDICATION_AI_API_KEY=your_medication_agent_api_key

# 3. Conversational Assistant Agent (Contextual explanations & FAQs)
ASSISTANT_AI_PROVIDER=google
ASSISTANT_AI_MODEL=gemini-1.5-flash
ASSISTANT_AI_API_KEY=your_assistant_agent_api_key

# 4. Optional generic fallback key (if specific agent key is left blank)
GEMINI_API_KEY=your_optional_fallback_gemini_key
