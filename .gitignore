# ========================================================
# ArogyaLink - Git Ignore Configuration
# ========================================================

# 1. Environment variables & sensitive keys (CRITICAL)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
server/.env
client/.env
client/.env.local

# Preserve example templates
!.env.example
!server/.env.example

# 2. Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# 3. Next.js & Build Outputs
.next/
client/.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# 4. Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. OS & Editor files
.DS_Store
*.pem
Thumbs.db
ehthumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 6. Testing & Coverage
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/
